# Pick a provider: xai | openai | openrouter | (any other name = OpenAI-compatible)
HARNESS_PROVIDER=xai
HARNESS_MODEL=grok-4-fast-non-reasoning

# xAI: https://api.x.ai/v1
XAI_API_KEY=

# OpenAI
# HARNESS_PROVIDER=openai
# OPENAI_API_KEY=
# HARNESS_BASE_URL=https://api.openai.com/v1
# HARNESS_MODEL=gpt-4.1

# OpenRouter (key may be OPENROUTER_API_KEY or OPENAI_API_KEY)
# HARNESS_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# HARNESS_MODEL=qwen/qwen3.5-9b:free
# HARNESS_BASE_URL=https://openrouter.ai/api/v1

# Any OpenAI-compatible endpoint (vLLM / Ollama / custom)
# HARNESS_PROVIDER=custom
# OPENAI_API_KEY=
# HARNESS_BASE_URL=http://127.0.0.1:11434/v1
# HARNESS_MODEL=llama3.1

# Generic fallback if you do not want a vendor-specific key name
# HARNESS_API_KEY=

# Skip the confirmation prompt for bash. Dangerous. Dev only.
# HARNESS_YOLO=1

# Drive the loop with a fake model (no API key needed).
# HARNESS_MOCK=1

# Streaming is on by default. Set 0 to wait for the full reply.
# HARNESS_STREAM=0

# Ask the provider for reasoning tokens and print them as think>.
# HARNESS_REASONING=0

# Retry count for HTTP 429 / rate limits.
# HARNESS_RETRY=3

# Front-end: textual (default on a tty) or repl. --ui NAME overrides.
# HARNESS_UI=repl
# HARNESS_UI_PLUGIN=mypkg.front:App

# Compact when last prompt tokens exceed this. Summarize via the model unless mock.
# HARNESS_COMPACT_AT=32000
# HARNESS_KEEP_LAST=16
# HARNESS_COMPACT_SUMMARIZE=0
